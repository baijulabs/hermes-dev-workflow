# Hermes Agent Workflow — Environment Variables
# Copy to ~/.hermes/profiles/orchestrator/.env and fill in values.

# GitHub token for API access (gh CLI)
GITHUB_TOKEN=

# OpenRouter API key (for LLM access across all profiles)
OPENROUTER_API_KEY=

# Telegram bot token (for cron job notifications)
TELEGRAM_BOT_TOKEN=

# ---- Optional ----
# Staging URL (for QA fix verification Layer 1 — API checks)
# HERMES_STAGING_URL=https://staging.example.com

# Staging database URL (for QA fix verification Layer 2 — DB checks)
# NEON_DATABASE_URL=postgresql://...
